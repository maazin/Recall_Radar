# Copy to .env for local runs outside Docker Compose.

DATABASE_URL=postgresql+psycopg://recallradar:recallradar@localhost:5432/recallradar

# Optional. openFDA works unauthenticated at low volume; add a free key if you
# start hitting rate limits: https://open.fda.gov/apis/authentication/
OPENFDA_API_KEY=

# How far back each ingestion run looks.
INGEST_LOOKBACK_DAYS=120

# Leave SMTP_HOST empty to log notifications instead of sending them.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM=RecallRadar <notifications@recallradar.example>

APP_BASE_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
